NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Use the exact VPS WireGuard address in production, e.g. 10.77.0.1.
TRUST_PROXY=loopback
# Filesystem path, not a PostgreSQL URL. Keep this on local disk.
DATABASE_URL=./data/maia-lms.db
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
STORAGE_ROOT=./data/storage
MEDIA_SIGNING_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MAIL_TRANSPORT=smtp://localhost:1025
MAIL_FROM=noreply@maiaplatform.org
WORKER_CONCURRENCY=4
MEDIA_WORKER_CONCURRENCY=1
# Fake checkout is the local/test default; production must use the real provider.
PAYMENT_PROVIDER=fake
# Use sandbox credentials outside production; select production only in the production deployment.
MP_ENVIRONMENT=sandbox
# Real-provider checkout stays disabled until sandbox purchase, refund, and webhook qualification.
PAYMENTS_CHECKOUT_ENABLED=false
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# MP_SELLER_ID=
# Docker: BIND_IP=127.0.0.1, HOST_PORT=3200, MAIL_TRANSPORT=smtp://mailpit:1025
# Production PUBLIC_BASE_URL=https://learn.maiaplatform.org

# Optional attachment scanning: disabled or clamav. clamav fails closed on scanner errors.
# Install clamscan and maintain its signature database before enabling.
ATTACHMENT_SCAN_MODE=disabled
