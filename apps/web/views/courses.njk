{% extends "base.njk" %}
{% block htmlLanguage %}{{ displayLocale or 'en' }}{% endblock %}
{% block metaDescription %}{{ description }}{% endblock %}
{% block content %}
<div id="message" role="status" aria-live="polite" tabindex="-1"></div>
<section id="app" class="seo-catalog">
  <h1>{{ title }}</h1>
  <ul>
    {% for course in courses %}
    <li>
      <article>
        {% if course.coverUrl %}<img src="{{ course.coverUrl }}" alt="{{ course.coverAlt }}">{% endif %}
        <h2><a href="{{ course.href }}">{{ course.title }}</a></h2>
        <p>{{ course.summary }}</p>
      </article>
    </li>
    {% else %}
    <li>No published courses are available yet.</li>
    {% endfor %}
  </ul>
</section>
<noscript>JavaScript is required for search and filters. Published courses are listed above.</noscript>
{% endblock %}