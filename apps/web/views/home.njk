{% extends "base.njk" %}
{% block htmlLanguage %}{{ displayLocale or 'en' }}{% endblock %}
{% block metaDescription %}{{ description or 'Courses to explore technology and turn knowledge into practice.' }}{% endblock %}
{% block content %}
<div id="message" role="status" aria-live="polite" tabindex="-1"></div>
<div id="app">
{% if homeSelection %}
	{% set hero = homeSelection.hero[0] %}
	{% if hero %}
	<section class="hero">
		<p class="eyebrow">{{ hero.locale }}</p>
		<h1>{{ hero.title }}</h1>
		{% if hero.coverUrl %}<img src="{{ hero.coverUrl }}" alt="{{ hero.coverAlt }}">{% endif %}
		<p>{{ hero.summary }}</p>
		<a class="button" href="{{ hero.href }}">{{ t('viewCourse') }}</a>
	</section>
	{% else %}
	<section class="hero"><h1 data-i18n="welcomeHeading">{{ t('welcomeHeading') }}</h1><p>{{ t('heroText') }}</p></section>
	{% endif %}
	{% if homeSelection.featured %}
	<section><h2>{{ t('homeFeatured') }}</h2><div class="grid">
		{% for course in homeSelection.featured %}<article class="card"><h3><a href="{{ course.href }}">{{ course.title }}</a></h3><p>{{ course.summary }}</p></article>{% endfor %}
	</div></section>
	{% endif %}
	{% if homeSelection.recommended %}
	<section><h2>{{ t('homeRecommended') }}</h2><div class="grid">
		{% for course in homeSelection.recommended %}<article class="card"><h3><a href="{{ course.href }}">{{ course.title }}</a></h3><p>{{ course.summary }}</p></article>{% endfor %}
	</div></section>
	{% endif %}
	<p><a href="/courses">{{ t('allCourses') }}</a></p>
{% else %}
	<h1 data-i18n="welcomeHeading">{{ t('welcomeHeading') }}</h1><p data-i18n="loadingCourses">{{ t('loadingCourses') }}</p>
{% endif %}
</div>
<noscript data-i18n="noscriptText">{{ t('noscriptText') }}</noscript>
{% endblock %}
