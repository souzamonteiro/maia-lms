# Managed by maia-lms install-vps.sh
server {
    listen 80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Upload requests are 512 KiB chunks; keep JSON/webhook requests bounded too.
    client_max_body_size 1m;
    client_body_timeout 120s;
    location / {
        proxy_pass http://__UPSTREAM__;
        proxy_http_version 1.1;
        # Stream chunks and media directly; do not spool uploads or long responses to proxy temp files.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 3600s;
    }
}
